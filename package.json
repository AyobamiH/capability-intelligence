{
  "name": "capability-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first capability intelligence for AI agent skills, plugins, tools, connectors, hooks, and workflow resources.",
  "type": "module",
  "bin": {
    "capability-intelligence": "bin/capability-intelligence.js",
    "capability": "bin/capability-intelligence.js"
  },
  "scripts": {
    "check": "npm run lint && npm test && npm run scan:strict",
    "lint": "node scripts/check-js.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "scan": "node bin/capability-intelligence.js scan",
    "scan:json": "node bin/capability-intelligence.js scan --json",
    "scan:strict": "node bin/capability-intelligence.js scan --strict --summary",
    "receipts:test": "node --test test/receipts.test.js",
    "serve": "node bin/capability-intelligence.js serve",
    "coverage": "node bin/capability-intelligence.js coverage",
    "audit:browser": "node test/browser-audit.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "bin/",
    "docs/privacy.md",
    "docs/BACKLOG.md",
    "docs/MATURITY.md",
    "docs/observed-receipts.md",
    "docs/product-contract.md",
    "docs/product-decisions.md",
    "docs/product-recon/README.md",
    "docs/product-recon/UNLABELLED_PLUGIN_MANIFEST_AUDIT.md",
    "docs/saas-architecture.md",
    "docs/source-coverage.md",
    "package-lock.json",
    "schemas/",
    "scripts/",
    "src/",
    "static/"
  ]
}
