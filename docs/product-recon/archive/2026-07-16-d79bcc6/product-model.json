  "jobsToBeDone": [
    {
      "priority": "primary",
      "classification": "confirmed",
      "statement": "When capability resources are distributed across an agent environment, the user wants one inventory so they can see what is discoverable without assuming it works."
    },
    {
      "priority": "primary",
      "classification": "confirmed",
      "statement": "When the user has an intended outcome, they want to find plausible resources and inspect readiness and risk so they can choose deliberately."
    },
    {
      "priority": "primary",
      "classification": "confirmed",
      "statement": "When a scan completes, the user wants source reconciliation so they can distinguish inventory completeness from operational verification."
    },
    {
      "priority": "secondary",
      "classification": "confirmed",
      "statement": "When hosts and skill roots overlap, the user wants duplicates and differences so they can identify drift."
    },
    {
      "priority": "secondary",
      "classification": "confirmed",
      "statement": "When inventory must be shared, the user wants a redacted export so selected private metadata is withheld."
    }
