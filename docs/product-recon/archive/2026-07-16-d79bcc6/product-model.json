  "product": {
    "name": "Capability Intelligence",
    "summary": "A standalone, local-first inventory that explains which agent-related capabilities are discoverable and what is known about their readiness, evidence, and risk.",
    "category": "local developer tool and capability inventory",
    "maturity": "early local alpha",
    "maturityClassification": "inferred",
    "commercialModel": null,
    "openSourceStatus": null,
    "confirmedValueProposition": [
      "Normalises fragmented local capability metadata into one deterministic inventory.",
      "Keeps discovered, present, installed, enabled, authenticated, runnable, and verified separate.",
      "Reports source accounting, evidence basis, metadata-derived risk, duplicates, and host differences."
    ],
    "outOfScope": [
      "capability execution",
      "plugin installation or enablement",
      "connector authentication",
      "autonomous coding workflow execution",
      "engineering-claim verification",
      "accounts and team administration",
      "billing and subscriptions"
    ]
  },
  "users": [
    {
      "id": "local-technical-operator",
      "classification": "inferred",
      "objective": "Understand what capabilities exist and what readiness evidence is actually available.",
      "knowledge": "Technical; comfortable with terminals, plugins, tools, and local metadata.",
      "deviceContext": "Desktop workstation primary; mobile inspection supported but not established as primary.",
      "success": "Relevant resources can be found without unknown states being converted into working or verified claims."
    },
    {
      "id": "capability-maintainer",
      "classification": "inferred",
      "objective": "Detect source gaps, duplicate skills, host drift, and unsafe or incomplete metadata.",
      "knowledge": "Advanced technical maintainer.",
      "deviceContext": "Terminal and desktop dashboard.",
      "success": "Every discovered record is accounted for and metadata limitations are visible."
    },
    {
      "id": "future-team-catalogue-user",
