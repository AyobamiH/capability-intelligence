{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capability-intelligence.local/schemas/inventory.schema.json",
  "title": "Capability Intelligence Inventory",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "mode",
    "summary",
    "sources",
    "artifacts",
    "graph",
    "findings",
    "coverage"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "mode": { "const": "local-read-only" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "records", "represented", "deduplicated", "parseFailures"]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "source", "capabilities", "classificationEvidence", "lifecycle", "risk", "metadata"]
      }
    },
    "coverage": {
      "type": "object",
      "required": ["status", "failures", "unlabelledManifests", "sourceCount", "artifactCount"],
      "properties": {
        "status": { "enum": ["passed", "failed"] }
      }
    }
  },
  "additionalProperties": true
}
