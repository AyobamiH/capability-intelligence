{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capability-intelligence.local/schemas/observed-receipt.schema.json",
  "title": "Capability Intelligence Observed Receipt Bundle",
  "type": "object",
  "required": ["schemaVersion", "receipts"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/receipt" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "receipt": {
      "type": "object",
      "required": [
        "receiptId",
        "artifactId",
        "artifactFingerprint",
        "contract",
        "outcome",
        "observedAt",
        "environment",
        "issuer",
        "checks"
      ],
      "properties": {
        "receiptId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "artifactId": { "type": "string", "minLength": 1, "maxLength": 240 },
        "artifactFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "contract": { "const": "capability-observation.v1" },
        "outcome": { "enum": ["passed", "failed"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "environment": { "enum": ["fixture", "local", "staging", "production"] },
        "issuer": { "type": "string", "minLength": 1, "maxLength": 120 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "enum": [
              "artifact_identity_matched",
              "invocation_completed",
              "expected_outcome_observed",
              "no_secret_output",
              "result_persisted"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
